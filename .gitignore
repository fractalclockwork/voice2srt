# -------------------------
# Python bytecode / caches
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# -------------------------
# Packaging / build
# -------------------------
*.egg-info/
*.egg
dist/
build/
pip-wheel-metadata/

# -------------------------
# Virtual environments
# -------------------------
.venv/
venv/
ENV/
env/

# Track uv.lock for reproducible installs (`uv lock`, commit lockfile).

# -------------------------
# Test / coverage / linters
# -------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.cover
.hypothesis/
.tox/
.nox/

# -------------------------
# Project outputs (CLI / experiments)
# -------------------------
output.srt
*.srt
*.vtt
*.log

# -------------------------
# Local media (keep dirs, ignore contents)
# -------------------------
audio/*
!audio/.gitkeep

# Optional local test assets (see README / CONTRIBUTING)
data/*
!data/.gitkeep

# -------------------------
# Secrets and local env (never commit)
# -------------------------
.env
.env.*
!.env.example
*.pem
secrets/

# -------------------------
# Jupyter
# -------------------------
.ipynb_checkpoints/

# -------------------------
# OS / editor
# -------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~

# VSCode
.vscode/

# PyCharm / JetBrains
.idea/
